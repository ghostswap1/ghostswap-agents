{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ghostswap-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "c7d9e8c806fde9525d8c3b0a47cf1447",
  "routes": [
    { "pattern": "mcp.ghostswap.io", "custom_domain": true }
  ],
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GhostSwapMCP"] }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "MCP_OBJECT", "class_name": "GhostSwapMCP" }
    ]
  },
  "unsafe": {
    "bindings": [
      {
        "name": "MCP_RATE_LIMITER",
        "type": "ratelimit",
        "namespace_id": "1001",
        "simple": { "limit": 30, "period": 60 }
      }
    ]
  },
  "observability": { "enabled": true }
}
