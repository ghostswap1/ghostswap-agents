    "exchange",
    "claude",
    "cursor",
    "windsurf",
    "no-kyc"
  ],
  "author": "GhostSwap (https://partners.ghostswap.io)",
  "license": "MIT",
  "homepage": "https://partners.ghostswap.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ghostswap1/ghostswap-agents.git",
    "directory": "mcp-server"
  },
  "bugs": "https://github.com/ghostswap1/ghostswap-agents/issues",
  "type": "module",
  "bin": {
    "ghostswap-mcp": "dist/index.js"
  },
